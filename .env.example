# ==============================================================================
# Vessli Marketplace - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# DO NOT commit .env with real secrets to public source control.

# --- Supabase Database & Auth ---
# Your Supabase Project URL (e.g. https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Key (for public client requests)
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Supabase Service Role Key (for secure backend proxy and edge functions)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Paystack Payment Gateway ---
# Paystack Secret Key (for server-side initialization and webhook verification)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Marketplace Platform Fee (0.10 represents 10% platform commission)
COMMISSION_RATE=0.10

# --- Amazon AWS S3 (Storage for Digital Assets) ---
# Note: On hosting platforms like Netlify or AWS Lambda, 'AWS_REGION' is a reserved system variable.
# Use 'VITE_S3_REGION' for frontend build and 'S3_REGION' for backend/Supabase.
S3_REGION=eu-north-1
VITE_S3_REGION=eu-north-1
AWS_REGION=eu-north-1

# AWS IAM Credentials with PutObject/GetObject permissions on product buckets
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# Bucket for public product cover images
S3_COVERS_BUCKET=vessli-covers
VITE_S3_COVERS_BUCKET=vessli-covers

# Bucket for private digital product download files (ZIPs, PDFs, etc.)
S3_FILES_BUCKET=vessli-product-files

# --- Google Gemini AI (Copilot, Magic Listing Fill, Quality Audits, Bundles) ---
# Your Gemini API Key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
